# Hardhat >= 3.10 runs on EDR >= 0.14 (Node >= 22) and refuses to start
# below Node 22.13.0; @chainlink/contracts 1.5 also requires Node >= 22.
# Fail the install on an older Node instead of letting `npx hardhat` break
# later. Matches "engines" in package.json.
engine-strict=true

# Do not resolve package versions published less than 7 days ago (same
# window as the Dependabot cooldown), so a hijacked or yanked release is
# usually caught upstream first. Enforced by npm >= 11.10; `npm ci` still
# installs the locked tree, only new resolution is held back. npm 10 (the
# one bundled with Node 22) accepts the key and ignores it.
min-release-age=7
