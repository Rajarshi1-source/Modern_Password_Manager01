# =========================
# Stage 1: Builder
# =========================
# Pinned to 3.11 DELIBERATELY, and it is the one place in this repo that is
# not on the 3.12 floor. The runtime stage below is
# gcr.io/distroless/python3-debian12, whose interpreter is Debian 12's -- i.e.
# Python 3.11 -- and this stage's whole output is a /venv copied into it. A
# 3.12 builder produces /venv/bin/python symlinks and lib/python3.12 paths plus
# compiled extension wheels with a 3.12 ABI tag, none of which the 3.11 runtime
# can load: daphne would fail at start, and no CI job builds this file, so
# nothing would have caught it. Raise this only together with the runtime image.
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps (build only). `apt-get -y upgrade` pulls patched curl +
# util-linux (Trivy #1393, #1396, #1399-#1403) into the builder layer.
# The runtime stage is distroless so none of these shell utilities
# reach the final image regardless, but patching the builder keeps
# anything that links against libcurl during pip installs on the
# fixed versions.
RUN apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY requirements-prod.txt .
COPY requirements-constraints.txt .

# Install dependencies into virtualenv
RUN python -m venv /venv \
    && /venv/bin/pip install --upgrade pip \
    && /venv/bin/pip install \
    --no-cache-dir \
    --require-hashes \
    -r requirements-prod.txt \
    -c requirements-constraints.txt

# Copy application
COPY . .

# =========================
# Stage 2: Runtime (Distroless)
# =========================
FROM gcr.io/distroless/python3-debian12:nonroot

WORKDIR /app

# Copy virtualenv and app
COPY --from=builder /venv /venv
COPY --from=builder /app /app

# Non-root execution
USER nonroot:nonroot

ENV PATH="/venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=password_manager.settings.production

# Health check using Python (since no curl/wget in distroless)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health/')" || exit 1

EXPOSE 8000

# KNOWN ISSUE, recorded rather than blind-fixed -- see the note below before
# deploying from this file.
#
# The distroless runtime sets its own ENTRYPOINT to the system interpreter, so
# these become ARGUMENTS to it: the container runs `python daphne -b ...` and
# Python looks for a FILE named `daphne`. Separately, `python -m venv` in the
# builder records that stage's `/usr/local/bin/python` as the venv's base, and
# that path does not exist in the runtime image, so `/venv/bin/*` console
# scripts have a dangling interpreter. Either alone stops the container from
# starting; the HEALTHCHECK below has the same shape (it needs a shell, and
# distroless has none).
#
# Not changed here because nothing can verify a change: NO CI job builds this
# file (grep the workflows -- only docs reference it), and the fix has to be
# validated against the real image, not reasoned about. It needs its own PR
# with a build-and-run smoke test. Recorded so nobody deploys this believing
# it works.
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "password_manager.asgi:application"]
